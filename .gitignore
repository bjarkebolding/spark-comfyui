# Runtime artifacts
thermal_monitor.log*

# Archives written by 'spark-comfyui.sh backup'
backups/

# Personal patch list (may reference private forks; the script seeds a
# commented template automatically on first install)
comfyui-patches.list

# Personal Comfy Registry node list (the script seeds it on first install,
# with one live entry; edited per box, so it is not tracked)
comfyui-nodes.list

# Container-only layout: all user content, and the personal mount
# configuration (seeded as a commented template, like the patch list)
data/
spark-mounts.conf

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code's own per-machine local settings (tool-permission allowlist)
.claude/

# Local-only contributor orientation for Claude Code; not shipped
CLAUDE.md
